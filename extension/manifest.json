{
  "manifest_version": 3,
  "name": "Meesho Seller Image Assistant",
  "version": "1.0.0",
  "description": "Helps Meesho sellers analyze product images, send them to an API, and compare candidates against a minimum price target.",
  "permissions": ["storage", "activeTab", "downloads"],
  "host_permissions": ["https://supplier.meesho.com/*", "https://upload.meeshosupplyassets.com/*"],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://supplier.meesho.com/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://supplier.meesho.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Meesho Seller Assistant"
  }
}

